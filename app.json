{
  "expo": {
    "name": "FOCAL",
    "slug": "focal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0A84FF"
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-updates"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sandrotonal.focal",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Focal uses Apple Health to read focus session data.",
        "NSHealthUpdateUsageDescription": "Focal records your completed focus sessions as Mindful Minutes in Apple Health."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111215",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sandrotonal.focal"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
